{
  "Comment": "Avaliacao de COVID-19",
  "StartAt": "coletar-temperatura",
  "States": {
    "coletar-temperatura": {
      "Type": "Task",
      "Resource": "${TriagemFunctionArn}",
      "ResultPath": "$.laudo",
      "Next": "checar-recomendacao-clinica"
    },

    "checar-recomendacao-clinica": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.laudo.diagnostico",
          "StringEquals": "quarantena",
          "Next": "marcar-consulta"
        }
      ],
      "Default": "registrar-laudo"
    },

    "marcar-consulta": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sqs:sendMessage.waitForTaskToken",
      "Parameters": {
        "QueueUrl": "${SQSQueueLegacyBookingURL}",
        "MessageBody": {
          "MessageTitle": "Task started by Step Functions. Waiting for callback with task token.",
          "TaskToken.$": "$$.Task.Token"
        }
      },
      "ResultPath": "$.laudo",
      "Next": "pagamento-consulta",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3
        }
      ],
      "Catch": [ {
        "ErrorEquals": ["States.All"],
        "Next": "cancelar-consulta"
      }]
    },

    "pagamento-consulta": {
      "Type": "Task",
      "Resource": "${TriagemFunctionArn}",
      "ResultPath": "$.laudo",
      "Next": "registrar-laudo",
      "Catch": [ {
        "ErrorEquals": ["States.All"],
        "Next": "cancelar-pagamento-consulta"
      }]
    },

    "cancelar-pagamento-consulta": {
      "Type": "Pass",
      "Next": "registrar-laudo"
    },

    "cancelar-consulta": {
      "Type": "Pass",
      "Next": "registrar-laudo"
    },

    "registrar-laudo": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "covid_MedicalRecord",
        "Item": {
          "id": {
            "S.$": "$.paciente-id"
          },
          "temperatura": {
            "S.$": "$.temperatura"
          }
        }
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Sates.ALL"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3
        }
      ],
      "ResultPath": "$.DynamoDB",
      "End": true
    }

  }
}