{
  "Comment": "Avaliacao de COVID-19",
  "StartAt": "coletar-temperatura",
  "States": {
    "coletar-temperatura": {
      "Type": "Task",
      "Resource": "${TriagemFunctionArn}",
      "ResultPath": "$.laudo",
      "Next": "registrar-laudo"
    },
    "registrar-laudo": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "covid_MedicalRecord",
        "Item": {
          "id": "$$.Execution.paciente-id",
          "temperatura": "$$.Execution.temperatura"
        }
      },
      "ResultPath": "$.DynamoDB",
      "Next": "marcar-consulta"
    },    
    "marcar-consulta": {
      "Type": "Pass",
      "Result": "consulta-agendada",
      "End": true
    }
  }
}